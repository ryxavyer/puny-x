{
  "name": "puny-x",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Solana → X announce bot for $PUNY. Holds no wallet keys; posts in-character narrations of on-chain activity.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "fixture": "ts-node scripts/fetch-fixture.ts",
    "list-recent": "ts-node scripts/list-recent.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts' 'test/**/*.ts'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@solana/web3.js": "^1.95.4",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "twitter-api-v2": "^1.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
